<view class="page" style="padding-top:{{navbarHeight}}px;box-sizing:border-box;">
  <!-- 自定义导航栏 -->
  <view class="navbar" style="padding-top:{{statusBarHeight}}px">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="openSettings">
        <t-icon name="setting" size="22px" color="#666666" />
      </view>
      <view class="navbar-title">价格监控</view>
      <view class="navbar-right" bindtap="goEvents">
        <t-icon name="notification" size="22px" color="#666666" />
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area">
  <!-- Task list -->
  <block wx:if="{{tasks.length}}">
    <block wx:for="{{tasks}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="openTaskDetail" catchlongpress="onLongPress">
        <!-- Route + Status + Price -->
        <view style="display: flex; align-items: center; justify-content: space-between;">
          <view style="display: flex; align-items: center; gap: 12rpx;">
            <view style="font-size: 32rpx; font-weight: 700; color: #0f172a;">{{item.routeText}}</view>
            <t-tag wx:if="{{item.monitorType === 'exchange_rate'}}" theme="default" variant="outline" size="small" style="flex-shrink: 0; color: #aaa;">汇率</t-tag>
            <t-tag wx:else theme="default" variant="outline" size="small" style="flex-shrink: 0; color: #aaa;">机票</t-tag>
            <t-tag wx:if="{{!item.active && !item.isExpired}}" theme="default" variant="light" size="small" style="flex-shrink: 0;">已暂停</t-tag>
            <t-tag wx:if="{{item.isExpired}}" theme="warning" variant="light" size="small" style="flex-shrink: 0;">已过期</t-tag>
          </view>
          <view style="display: flex; align-items: center; gap: 12rpx;">
            <view wx:if="{{item.currentPrice != null}}" style="display: flex; align-items: baseline; gap: 4rpx;">
              <text wx:if="{{item.monitorType === 'exchange_rate'}}" style="font-size: 24rpx; color: #888888;">当前汇率</text>
              <text wx:else style="font-size: 24rpx; color: #888888;">当前最低价</text>
              <text style="font-size: 32rpx; font-weight: 700; color: #0f172a;">{{item.priceText}}</text>
            </view>
            <view wx:else style="font-size: 24rpx; color: #888888;">暂无数据</view>
          </view>
        </view>

        <!-- Dates + Last change -->
        <view style="margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between;">
          <view style="font-size: 24rpx; color: #888888;">
            <text wx:if="{{item.monitorType === 'exchange_rate'}}">{{item.baseCurrency}}/{{item.quoteCurrency}} 实时汇率</text>
            <text wx:else>{{item.departDatesText}} <text wx:if="{{item.flightWay === 'Roundtrip'}}"> 往返</text><text wx:else> 单程</text></text>
          </view>
          <view wx:if="{{item.latestChangeInfo}}" style="font-size: 24rpx; display: flex; align-items: center; gap: 8rpx;">
            <text style="color: #888888;">{{item.latestChangeInfo.timeStr}}</text>
            <text wx:if="{{item.latestChangeInfo.type === 'drop'}}" style="color: #16a34a;">↓{{item.deltaText}}</text>
            <text wx:if="{{item.latestChangeInfo.type === 'rise'}}" style="color: #dc2626;">↑{{item.deltaText}}</text>
          </view>
          <view wx:else style="font-size: 24rpx; color: #888888;">尚未变价</view>
        </view>

        <view wx:if="{{item.lastError}}" style="margin-top: 8rpx; color: #dc2626; font-size: 24rpx;">
          错误：{{item.lastError}}
        </view>
      </view>
    </block>
  </block>

  <!-- Empty state -->
  <view wx:else style="display: flex; align-items: center; justify-content: center; height: 60vh;">
    <text style="font-size: 28rpx; color: #aaaaaa;">当前暂无监控任务</text>
  </view>
  </view>

  <!-- FAB -->
  <t-fab icon="add" bind:click="goCreateTask" />

  <!-- 创建类型选择 -->
  <t-action-sheet
    visible="{{showCreateSheet}}"
    items="{{createTypeItems}}"
    bind:selected="onCreateTypeSelect"
    bind:cancel="onCreateTypeClose"
    bind:visible-change="onCreateTypeClose"
  />

  <!-- ActionSheet -->
  <t-action-sheet
    visible="{{showActionSheet}}"
    items="{{actionItems}}"
    bind:selected="onActionSheetSelect"
    bind:cancel="onActionSheetClose"
    bind:visible-change="onActionSheetVisibleChange"
  />

  <t-action-sheet
    visible="{{showSettingsSheet}}"
    items="{{settingsItems}}"
    bind:selected="onSettingsSelect"
    bind:cancel="onSettingsClose"
    bind:visible-change="onSettingsClose"
  />

  <t-popup visible="{{showPushplusPopup}}" placement="bottom" bind:visible-change="closePushplusPopup">
    <view class="settings-popup">
      <view class="settings-popup-title">推送渠道设置</view>
      <view class="settings-popup-desc">请前往 PushPlus 官网获取推送 Token 填入下方，关注 PushPlus 服务号即可获取实时推送。</view>
      <view style="margin: 0 32rpx; border-bottom: 1rpx solid #e5e7eb;">
        <input
          placeholder="请输入 PushPlus Token"
          value="{{pushplusTokenInput}}"
          bindinput="onPushplusInputChange"
          style="width: 100%; height: 80rpx; font-size: 28rpx; color: #333; text-align: center;"
          placeholder-style="color: #bbb; text-align: center;"
        />
      </view>
      <view class="settings-popup-actions" style="margin: 32rpx 32rpx 0;">
        <view class="settings-popup-btn">
          <t-button theme="default" variant="outline" block bind:tap="closePushplusPopup">取消</t-button>
        </view>
        <view class="settings-popup-btn">
          <t-button theme="primary" block loading="{{savingUserSettings}}" bind:tap="savePushplusToken">保存</t-button>
        </view>
      </view>
    </view>
  </t-popup>

  <t-popup visible="{{showSilentPopup}}" placement="bottom" bind:visible-change="closeSilentPopup">
    <view class="settings-popup">
      <view class="settings-popup-title">自动休眠设置</view>
      <view class="settings-popup-desc">监控任务如果开启自动休眠，将会在该休眠时段自动暂停查询和推送</view>
      <t-cell title="开始时间" arrow bindtap="openSilentPicker" data-field="start">
        <text slot="note">{{silentDraftStart}}</text>
      </t-cell>
      <t-cell title="结束时间" arrow bindtap="openSilentPicker" data-field="end">
        <text slot="note">{{silentDraftEnd}}</text>
      </t-cell>
      <view class="settings-popup-actions" style="margin: 32rpx 32rpx 0;">
        <view class="settings-popup-btn">
          <t-button theme="default" variant="outline" block bind:tap="closeSilentPopup">取消</t-button>
        </view>
        <view class="settings-popup-btn">
          <t-button theme="primary" block loading="{{savingUserSettings}}" bind:tap="saveSilentSettings">保存</t-button>
        </view>
      </view>
    </view>
  </t-popup>

  <t-picker
    visible="{{showTimePicker}}"
    title="{{timePickerTitle}}"
    value="{{timePickerValue}}"
    bind:confirm="onSilentPickerConfirm"
    bind:cancel="onSilentPickerCancel"
  >
    <t-picker-item options="{{timePickerOptions[0]}}"></t-picker-item>
    <t-picker-item options="{{timePickerOptions[1]}}"></t-picker-item>
  </t-picker>

  <!-- Delete Dialog -->
  <t-dialog
    visible="{{showDeleteDialog}}"
    title="确认删除"
    content="删除后无法恢复，确认要删除这个任务吗？"
    confirm-btn="删除"
    cancel-btn="取消"
    bind:confirm="doDelete"
    bind:cancel="onCloseDeleteDialog"
  />
</view>
