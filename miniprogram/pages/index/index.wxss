.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.toolbar-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.toolbar-action-text {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}

.toolbar-status {
  font-size: 22rpx;
  color: #64748b;
}

.settings-popup {
  padding: 40rpx 32rpx 48rpx;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.settings-popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.settings-popup-desc {
  margin: 12rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.settings-popup-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #9ca3af;
}
