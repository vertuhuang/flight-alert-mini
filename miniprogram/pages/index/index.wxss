/* 自定义导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #f5f5f5;
  z-index: 100;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.navbar-left {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 60rpx;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', Helvetica, 'Microsoft YaHei', sans-serif;
}

.navbar-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 60rpx;
}

/* 内容区域上边距（避让固定导航栏） */
.content-area {
  margin-top: 8rpx;
}

.settings-popup {
  padding: 40rpx 0 48rpx;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.settings-popup-title {
  margin: 0 32rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.settings-popup-desc {
  margin: 12rpx 32rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #888888;
}

.settings-popup-actions {
  display: flex;
  gap: 32rpx;
}

.settings-popup-btn {
  flex: 1;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #9ca3af;
}
