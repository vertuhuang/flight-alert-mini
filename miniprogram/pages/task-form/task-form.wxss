.field-label {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.date-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.date-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.date-tag--add {
  background: #eff6ff;
  color: #2563eb;
  border: 1rpx dashed #2563eb;
}

.date-tag__remove {
  color: #94a3b8;
  font-size: 22rpx;
  padding: 4rpx;
}

/* TDesign 组件样式调整 */
.custom-cell {
  padding-left: 32rpx !important;
  padding-right: 16rpx !important;
}

.custom-cell .t-cell__right-icon {
  font-size: 28rpx !important;
}

.custom-input {
  padding-left: 32rpx !important;
  padding-right: 32rpx !important;
}

.custom-textarea {
  padding-left: 32rpx !important;
  padding-right: 32rpx !important;
}

.form-list {
  margin-left: -32rpx;
  margin-right: -32rpx;
  margin-bottom: -32rpx;
  overflow: hidden;
  border-radius: 0 0 24rpx 24rpx;
}

/* 底部弹出设置抽屉（与 index 页保持一致） */
.settings-popup {
  padding: 40rpx 0 48rpx;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.settings-popup-title {
  margin: 0 32rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.settings-popup-desc {
  margin: 12rpx 32rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #888888;
}

.settings-popup-actions {
  display: flex;
  gap: 32rpx;
}

.settings-popup-btn {
  flex: 1;
}
